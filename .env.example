# Keep real credentials in .env only. Never commit production secrets.

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require

# AWS S3
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-private-bucket-name

# OpenAI API (automatic coach notes on each report)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
# Set to false to always use the built-in note templates instead of AI
AI_COACH_NOTES_ENABLED=true

# Email (signup verification codes and password reset).
# Leave SMTP_PASSWORD empty until the Google App Password is available;
# signup then works without verification and password reset is hidden.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=bluerun-account@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=bluerun-account@gmail.com
SMTP_FROM_NAME=Bluerun

# Authentication and initial administrator
JWT_SECRET=replace-with-a-long-random-secret
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
DEFAULT_ADMIN_NAME=Bluerun Admin

# Background processing (see PRODUCTION_SETUP.md)
# inline = API process runs jobs (local default); worker = run `python worker.py` / the worker service
JOB_RUNNER=inline
# Production: false (run `python migrate.py` on deploy). Local: true applies schema changes on start.
RUN_MIGRATIONS_ON_STARTUP=true
WORKER_POLL_SECONDS=3

# Download versions: rendered in parallel (keep 1 on a 2-vCPU server)
EXPORT_WORKERS=1
# Made right after analysis; others are made on first request. "all" = everything up front.
EXPORTS_EAGER=athlete:vertical
# Keep in sync with the S3 lifecycle rule on uploads/ and export-sources/
EXPORT_SOURCE_RETENTION_DAYS=30

# Browser uploads straight to S3 (needs the bucket CORS rule first)
DIRECT_S3_UPLOADS=false
MAX_UPLOAD_MB=2048

# Write detailed per-frame scoring to ski_analysis.log (debugging only)
FRAME_METRICS_LOG=false
